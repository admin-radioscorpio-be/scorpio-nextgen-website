{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "www",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],

	// To add EmDash CMS back, restore these bindings:
	// "d1_databases": [{ "binding": "DB", "database_name": "my-emdash-site", "database_id": "0dbdb94b-a620-480d-9673-ffa9c4f48158" }],
	// "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "my-emdash-media", "preview_bucket_name": "my-emdash-media" }],
	// "worker_loaders": [{ "binding": "LOADER" }],

	"routes": [
		{
			"pattern": "www.radioscorpio.be",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
